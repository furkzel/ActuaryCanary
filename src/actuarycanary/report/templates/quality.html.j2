<section id="quality" class="page">
  <h2>{{ tr("Data quality appendix") }}</h2>
  <p>{{ trh("Score <strong>{score}</strong> out of 100 ({spec}): {rules} rules evaluated; {blocking} blocking, {warning} warning and {info} information findings. The score is a summary; read the findings before any result.", score=overall, spec=spec("DQ01"), rules=rules, blocking=counts.BLOCKING, warning=counts.WARNING, info=counts.INFO) }}</p>
  <h3>{{ tr("What was loaded") }}</h3>
  <div class="scroll"><table>
    <thead><tr><th>{{ tr("Concept") }}</th><th>{{ tr("Rows") }}</th><th>{{ tr("First") }}</th><th>{{ tr("Last") }}</th><th>{{ tr("Score") }}</th><th>{{ tr("Source") }}</th></tr></thead>
    <tbody>{% for c in coverage %}<tr><td>{{ c.concept }}</td><td>{{ c.rows }}</td><td>{{ c.first }}</td><td>{{ c.last }}</td><td>{{ c.score }}</td><td class="text">{{ c.sources }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <h3>{{ tr("Analyses") }}</h3>
  <div class="scroll"><table>
    <thead><tr><th>{{ tr("Module") }}</th><th>{{ tr("Status") }}</th><th>{{ tr("Why") }}</th></tr></thead>
    <tbody>{% for m in modules %}<tr><td class="text">{{ m.module }} {{ m.title }}</td><td class="text{% if m.status_code == 'unable' %} negative{% endif %}">{{ m.status }}</td><td class="text">{{ m.reasons }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <h3>{{ tr("Findings") }}</h3>
  {% if findings %}
  <div class="scroll"><table>
    <thead><tr><th>{{ tr("Severity") }}</th><th>{{ tr("Dimension") }}</th><th>{{ tr("Rule") }}</th><th>{{ tr("Count") }}</th><th>{{ tr("What") }}</th><th>{{ tr("Fields") }}</th><th>{{ tr("Modules affected") }}</th><th>{{ tr("First source rows") }}</th></tr></thead>
    <tbody>{% for f in findings %}<tr><td class="text{% if f.severity_code == 'BLOCKING' %} negative{% endif %}">{{ f.severity }}</td><td class="text">{{ f.dimension }}</td><td class="text">{{ f.rule }}</td><td>{{ tr("{count} of {checked}", count=f.count, checked=f.checked) }}</td><td class="text">{{ f.message }}</td><td class="text">{{ f.fields }}</td><td class="text">{{ f.modules }}</td><td class="text">{{ f.refs }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>{{ tr("No finding.") }}</p>{% endif %}
  <details>
    <summary>{{ tr("Scores by dimension, concept and field") }}</summary>
    <div class="scroll"><table>
      <thead><tr><th>{{ tr("Level") }}</th><th>{{ tr("Name") }}</th><th>{{ tr("Score") }}</th><th>{{ tr("Rules") }}</th></tr></thead>
      <tbody>{% for r in scores %}<tr><td class="text">{{ r.level }}</td><td class="text">{{ r.name }}</td><td>{{ r.score }}</td><td>{{ r.rules }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </details>
  {% if not_evaluated %}
  <details>
    <summary>{{ tr("Rules not evaluated ({n})", n=not_evaluated|length) }}</summary>
    <ul class="notes">{% for rule, reason in not_evaluated %}<li>{{ rule }}: {{ reason }}</li>{% endfor %}</ul>
  </details>
  {% endif %}
  <p class="footnote">{{ tr("Rule IDs refer to the data concept specifications; row numbers are spreadsheet rows. The full list with every count is in quality.json.") }}</p>
</section>
