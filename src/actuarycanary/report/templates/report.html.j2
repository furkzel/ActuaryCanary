<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} report {{ run_id }}</title>
<style>
:root {
  --surface: #fcfcfb; --surface-2: #f3f2ee; --border: #dddcd6;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #6f6e69;
  --accent: #2a78d6; --warning-bg: #fff4d6; --warning-ink: #6b4a00; --critical: #b42f2f;
  --grid: #e6e5e0;
  --seq: "#cde2fb,#9ec5f4,#6da7ec,#3987e5,#256abf,#184f95,#0d366b";
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --surface: #1a1a19; --surface-2: #242423; --border: #3a3a37;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a998f;
    --accent: #3987e5; --warning-bg: #3a2f12; --warning-ink: #f2d38a; --critical: #e66767;
    --grid: #33332f;
    --seq: "#0d366b,#184f95,#256abf,#3987e5,#6da7ec,#9ec5f4,#cde2fb";
  }
}
:root[data-theme="dark"] {
  --surface: #1a1a19; --surface-2: #242423; --border: #3a3a37;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a998f;
  --accent: #3987e5; --warning-bg: #3a2f12; --warning-ink: #f2d38a; --critical: #e66767;
  --grid: #33332f;
  --seq: "#0d366b,#184f95,#256abf,#3987e5,#6da7ec,#9ec5f4,#cde2fb";
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--surface); color: var(--text-primary);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 1.7rem; margin: 0 0 4px; }
h2 { font-size: 1.3rem; margin: 40px 0 8px; padding-top: 8px; border-top: 1px solid var(--border); }
h3 { font-size: 1.05rem; margin: 24px 0 8px; }
p, li { color: var(--text-secondary); }
.label {
  display: inline-block; margin: 8px 0 16px; padding: 4px 10px; border-radius: 4px;
  background: var(--warning-bg); color: var(--warning-ink); font-weight: 600;
}
dl.cover { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; }
dl.cover dt { color: var(--text-muted); }
dl.cover dd { margin: 0; overflow-wrap: anywhere; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; margin: 8px 0; }
th, td { padding: 4px 8px; border-bottom: 1px solid var(--grid); text-align: right; white-space: nowrap; }
th { color: var(--text-secondary); font-weight: 600; background: var(--surface-2); }
th:first-child, td:first-child, td.text { text-align: left; }
tr.total td { font-weight: 600; border-top: 2px solid var(--border); }
td.negative { color: var(--critical); }
.charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
.chart { min-height: 300px; }
.footnote { font-size: 0.85rem; color: var(--text-muted); margin: 4px 0 0; }
details { margin: 8px 0; }
summary { cursor: pointer; color: var(--accent); }
a { color: var(--accent); }
ul.notes li { color: var(--text-secondary); }
code { font-size: 0.9em; overflow-wrap: anywhere; }
nav ul { padding-left: 20px; }
@media print { .chart { break-inside: avoid; } details { display: block; } }
</style>
</head>
<body>
<main>

<header>
  <h1>{{ title }}: claims reserving overview</h1>
  <div class="label">Indicative — not an official reserve or price</div>
  <dl class="cover">
    <dt>Run id</dt><dd><code>{{ run_id }}</code></dd>
    <dt>Valuation cut-off</dt><dd>{{ cut_off }}</dd>
    <dt>Bases</dt><dd>{{ basis_label }} · reporting currency {{ currency }}</dd>
    <dt>Origins</dt><dd>{{ settings.origin_period.value }} periods, origin axis {{ origin_basis }}</dd>
    <dt>Development</dt><dd>{{ settings.development_period.value }} periods aligned to the cut-off</dd>
    <dt>Claims used</dt><dd>{{ claims_used }}{% if proxy_claims != "0" %} ({{ proxy_claims }} with first-valuation proxy origins){% endif %}</dd>
    <dt>Inputs</dt><dd>{% for i in inputs %}{{ i.name }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
  </dl>
  <p>{{ disclaimer }}</p>
</header>

<nav>
  <h2>Contents</h2>
  <ul>
    {% if quality_html %}<li><a href="#quality">Data quality</a></li>
    {% endif %}{% if modules_html %}<li><a href="#modules">Modules and measures</a></li>
    {% endif %}<li><a href="#summary">Summary by segment and line</a></li>
    {% for g in groups %}<li><a href="#{{ g.anchor }}">{{ g.name }}</a></li>
    {% endfor %}<li><a href="#data">Data notes</a></li>
    <li><a href="#methods">Methods and assumptions</a></li>
    <li><a href="#reproducibility">Reproducibility</a></li>
  </ul>
</nav>

{% if quality_html %}{{ quality_html|safe }}

{% endif %}{% if modules_html %}{{ modules_html|safe }}

{% endif %}<section id="summary">
  <h2>Summary by segment and line</h2>
  <p>Amounts in {{ currency }}; segments are shown separately and never added together.{% if value_date %} Amounts are at the prices of {{ value_date }} ({{ price_index }}); they are turned into nominal amounts only with a stated future inflation assumption ({{ spec("CV02") }}).{% endif %}</p>
  <div class="scroll"><table>
    <thead><tr><th>Segment · line</th><th>Paid</th><th>Incurred</th><th>Ultimate, paid CL</th><th>Ultimate, incurred CL</th><th>IBNR, incurred CL</th><th>Ultimate, selected</th><th>IBNR, selected</th></tr></thead>
    <tbody>
    {% for g in groups %}<tr><td><a href="#{{ g.anchor }}">{{ g.name }}</a></td><td>{{ g.summary.paid }}</td><td>{{ g.summary.incurred }}</td><td>{{ g.summary.ult_paid }}</td><td>{{ g.summary.ult_incurred }}</td><td>{{ g.summary.ibnr_incurred }}</td><td>{{ g.summary.ult_selected }}</td><td>{{ g.summary.ibnr_selected }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="footnote">Ultimates by chain ladder ({{ spec("MT02") }}) on paid and on incurred triangles ({{ spec("MT01") }}); IBNR = ultimate − incurred at the cut-off ({{ spec("RS02") }}). The selected ultimate is chain ladder where the reported share is at least 0.5 and Bornhuetter–Ferguson below it ({{ spec("MT10") }}). Paid {{ spec("CL01") }}, incurred {{ spec("CL03") }}. Rounded per {{ spec("CV06") }}; totals from unrounded values.</p>
</section>

{% for g in groups %}
<section id="{{ g.anchor }}">
  <h2>{{ g.name }}</h2>
  <div class="label">Indicative — not an official reserve or price</div>

  <h3>Development triangles</h3>
  <div class="charts">
    <div class="chart" id="{{ g.figure_ids.paid }}" role="img" aria-label="Heatmap of the cumulative paid triangle, {{ g.name }}"></div>
    <div class="chart" id="{{ g.figure_ids.incurred }}" role="img" aria-label="Heatmap of the cumulative incurred triangle, {{ g.name }}"></div>
  </div>
  <p class="footnote">Cumulative cells by origin and development age, {{ currency }}, {{ basis_label }}; the more a cell stands out from the page, the larger it is ({{ spec("MT01") }}, {{ spec("CV04") }}). Hover a cell for its value and claim count.</p>
  <details>
    <summary>Triangle values</summary>
    {% for measure in ["paid", "incurred"] %}
    <div class="scroll"><table>
      <thead><tr><th>{{ measure|capitalize }}</th>{% for a in g.ages %}<th>{{ a }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in g.triangles[measure] %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table></div>
    {% endfor %}
  </details>

  <h3>Development factors</h3>
  <div class="scroll"><table>
    <thead><tr><th>Age (months)</th><th>To</th><th>Factor, paid</th><th>CDF, paid</th><th>Factor, incurred</th><th>CDF, incurred</th></tr></thead>
    <tbody>{% for f in g.factors %}<tr><td>{{ f.from }}</td><td>{{ f.to }}</td><td>{{ f.paid_factor }}</td><td>{{ f.paid_cdf }}</td><td>{{ f.incurred_factor }}</td><td>{{ f.incurred_cdf }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <p class="footnote">Volume-weighted age-to-age factors and cumulative factors to ultimate; last row is the tail factor ({{ spec("RS01") }}, {{ spec("MT02") }}).</p>

  <h3>Ultimate and IBNR</h3>
  <div class="scroll"><table>
    <thead><tr><th>Origin</th><th>Paid</th><th>Incurred</th><th>Ultimate, paid CL</th><th>Ultimate, incurred CL</th><th>IBNR, paid CL</th><th>IBNR, incurred CL</th></tr></thead>
    <tbody>{% for e in g.estimates %}<tr{% if e.total %} class="total"{% endif %}><td>{{ e.origin }}</td><td>{{ e.paid }}</td><td>{{ e.incurred }}</td><td>{{ e.ult_paid }}</td><td>{{ e.ult_incurred }}</td><td{% if e.negative_paid %} class="negative"{% endif %}>{{ e.ibnr_paid }}</td><td{% if e.negative_incurred %} class="negative"{% endif %}>{{ e.ibnr_incurred }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <p class="footnote">{{ currency }}, {{ basis_label }}. IBNR = ultimate − incurred at the cut-off; a negative IBNR (red) means the method expects case reserves to run off favourably ({{ spec("RS02") }}, {{ spec("MT02") }}).</p>
  {% if g.notes %}<ul class="notes">{% for n in g.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}

  {% set m = g.methods %}
  <h3>Ultimates by method</h3>
  <div class="scroll"><table>
    <thead><tr><th>Origin</th>{% for h in m.ultimates.headers %}<th>{{ h }}</th>{% endfor %}<th>Selected</th><th>Chosen</th><th>Why</th></tr></thead>
    <tbody>{% for r in m.ultimates.rows %}<tr{% if r.total %} class="total"{% endif %}><td>{{ r.origin }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.selected }}</td><td class="text">{{ r.chosen }}</td><td class="text">{{ r.why }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <p class="footnote">{{ currency }}, {{ basis_label }}. Selected ultimate on the {{ m.selection_measure }} triangle ({{ spec("MT10") }}); other methods {{ spec("MT03") }}, {{ spec("MT04") }}, {{ spec("MT05") }}, {{ spec("MT07") }}. The inflation-adjusted figures are at the prices of the value date unless a future inflation is stated.</p>
  {% if m.not_run %}<ul class="notes">{% for n in m.not_run %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}

  {% if m.mack %}
  <h3>Mack standard error</h3>
  <div class="scroll"><table>
    <thead><tr><th>Origin</th><th>Reserve, paid</th><th>Standard error, paid</th><th>CV, paid</th><th>Reserve, incurred</th><th>Standard error, incurred</th><th>CV, incurred</th></tr></thead>
    <tbody>{% for r in m.mack.rows %}<tr{% if r.total %} class="total"{% endif %}><td>{{ r.origin }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
  <div class="scroll"><table>
    <thead><tr><th>Total reserve (selected)</th><th>Reserve</th><th>75th percentile</th><th>95th percentile</th><th>99.5th percentile</th><th>VaR 99.5%</th><th>TVaR 99%</th></tr></thead>
    <tbody>{% for r in m.mack.ranges %}<tr><td>{{ r.measure }}</td><td>{{ r.reserve }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}{% if not r.cells %}<td class="text" colspan="5">not shown: the reserve is not positive or the standard error is zero</td>{% endif %}</tr>{% endfor %}</tbody>
  </table></div>
  <p class="footnote">Approximation: Mack standard error with a lognormal assumption ({{ spec("MT06") }}, {{ spec("RS03") }}); where the selected reserve is not the Mack chain-ladder reserve the Mack coefficient of variation is applied to it.</p>
  {% endif %}

  {% if m.inflation %}
  <h3>Inflation-adjusted chain ladder</h3>
  <div class="scroll"><table>
    <thead><tr><th>Origin</th><th>Paid, value-date prices</th><th>Ultimate, value-date prices</th><th>Unpaid, value-date prices</th><th>Paid, nominal</th><th>Ultimate, nominal</th><th>Unpaid, nominal</th></tr></thead>
    <tbody>{% for r in m.inflation.rows %}<tr><td>{{ r.origin }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
  <p class="footnote">Paid chain ladder on triangles at the prices of {{ m.inflation.value_date }} ({{ spec("MT07") }}). {% if m.inflation.future_inflation %}Future payments are re-inflated with {{ m.inflation.future_inflation }} a year (assumptions register).{% else %}No future inflation is stated, so the nominal ultimate and unpaid are empty.{% endif %}</p>
  {% endif %}

  <h3>Diagnostics</h3>
  {% if m.diagnostics %}
  <div class="scroll"><table>
    <thead><tr><th>Triangle</th><th>Method</th><th>Diagnostic</th><th>Where</th><th>What</th></tr></thead>
    <tbody>{% for d in m.diagnostics %}<tr><td class="text">{{ d.measure }}</td><td class="text">{{ d.method }}</td><td class="text">{{ d.code }}</td><td class="text">{{ d.target }}</td><td class="text">{{ d.message }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>No diagnostic was raised for this group.</p>{% endif %}
  {% if m.stability %}
  <details>
    <summary>Factor stability</summary>
    {% for t in m.stability %}
    <div class="scroll"><table>
      <thead><tr><th>{{ t.measure|capitalize }} column</th><th>Link ratios used</th><th>Lowest</th><th>Highest</th><th>CV</th>{% for n in t.names %}<th>{{ n }}</th>{% endfor %}<th>Selected</th></tr></thead>
      <tbody>{% for r in t.rows %}<tr><td>{{ r.column }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table></div>
    {% endfor %}
  </details>
  {% endif %}
</section>
{% endfor %}

<section id="data">
  <h2>Data notes</h2>
  {% if not_converted %}
  <h3>Amounts not converted</h3>
  <p>No exchange rate{% if value_date %} or index value{% endif %} was available for these amounts, so the claims are left out of the {{ currency }} triangles{% if value_date %} from their first row that could not be converted or restated{% endif %} and shown here at the cut-off, in their own currency ({{ spec("CV01") }}).</p>
  <div class="scroll"><table>
    <thead><tr><th>Currency</th><th>Claims</th><th>Paid</th><th>Incurred</th></tr></thead>
    <tbody>{% for r in not_converted %}<tr><td>{{ r.currency }}</td><td>{{ r.claims }}</td><td>{{ r.paid }}</td><td>{{ r.incurred }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
  <h3>Rules applied to rows</h3>
  {% if findings %}
  <div class="scroll"><table>
    <thead><tr><th>Rule</th><th>File</th><th>Severity</th><th>Rows</th><th>What happened</th><th>First source rows</th></tr></thead>
    <tbody>{% for f in findings %}<tr><td>{{ f.rule }}</td><td class="text">{{ f.concept }}</td><td class="text">{{ f.severity }}</td><td>{{ f.count }}</td><td class="text">{{ f.message }}</td><td class="text">{{ f.rows|join(", ") }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>No row was changed or left out.</p>{% endif %}
  <p class="footnote">Rule IDs refer to the data concept and convention specifications; row numbers are spreadsheet rows.</p>
</section>

<section id="methods">
  <h2>Methods and assumptions</h2>
  <ul>
    <li><strong>{{ spec("MT01") }} triangle construction.</strong> The state of a claim at a valuation point is its latest valuation row on or before that point. Origin {{ settings.origin_period.value }}, development {{ settings.development_period.value }}, origin axis {{ settings.origin_axis.value }}, fiscal year starting in month {{ settings.fiscal_year_start_month }}. {% if value_date %}Each amount is converted at the rate of its own date and restated to the prices of {{ value_date }} with {{ price_index }}; incurred is the accumulated restated paid flows plus the restated case reserve ({{ spec("CV01") }}, {{ spec("CV02") }}).{% else %}Amounts converted with one constant rate per currency ({{ spec("CV01") }}).{% endif %}</li>
    <li><strong>{{ spec("MT02") }} chain ladder.</strong> Average {{ chain_ladder.average.value }}, {% if chain_ladder.n_diagonals %}latest {{ chain_ladder.n_diagonals }} diagonals{% else %}all diagonals{% endif %}, high and low {% if chain_ladder.exclude_high_low %}excluded{% else %}kept{% endif %}, tail factor {{ chain_ladder.tail_factor }}, at least {{ chain_ladder.min_origins }} origins. No link ratio excluded and no factor overridden. Assumes future development follows past factors, comparable origins and no calendar-period shocks.</li>
      <li><strong>{{ spec("MT03") }}, {{ spec("MT04") }}, {{ spec("MT05") }} premium-based methods.</strong> Earned premium per origin from {{ spec("PR02") }} on the same bases. The prior loss ratio is the register's entry or, without one, the Cape Cod ratio of the same triangle, labelled data-derived.</li>
    <li><strong>{{ spec("MT06") }} Mack standard error.</strong> Volume-weighted factors over all diagonals, no exclusions; percentiles, value at risk and tail value at risk assume a lognormal reserve and are an approximation.</li>
    <li><strong>{{ spec("MT07") }} inflation-adjusted chain ladder.</strong> Paid chain ladder on triangles restated to the prices of the value date; future payments stay at those prices unless a future inflation is stated.</li>
    <li><strong>{{ spec("MT10") }} selection.</strong> Chain ladder for origins with a reported share of at least 0.5, Bornhuetter–Ferguson below it, unless the register overrides.</li>
    <li><strong>{{ spec("MT08") }} and {{ spec("MT09") }} anomaly flags.</strong> Robust z-score on payments and case-reserve movements, isolation forest on claims; the flags are leads for a reviewer, listed with their source rows in <code>anomalies.csv</code>.</li>
  </ul>
  <h3>Anomaly flags</h3>
  {% if anomaly_rows %}
  <div class="scroll"><table>
    <thead><tr><th>Method</th><th>Segment · line</th><th>Flags</th></tr></thead>
    <tbody>{% for r in anomaly_rows %}<tr><td class="text">{{ r.method }}</td><td class="text">{{ r.group }}</td><td>{{ r.flags }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>No claim or payment was flagged.</p>{% endif %}
  <h3>Assumptions in force</h3>
  <details>
    <summary>{{ assumptions|length }} judgements, those by default included</summary>
    <div class="scroll"><table>
      <thead><tr><th>Method</th><th>Parameter</th><th>Scope</th><th>Target</th><th>Value</th><th>Default</th><th>Who</th><th>When</th><th>Why</th></tr></thead>
      <tbody>{% for a in assumptions %}<tr><td class="text">{{ a.method }}</td><td class="text">{{ a.name }}</td><td class="text">{{ a.scope }}</td><td class="text">{{ a.target }}</td><td class="text">{{ a.value }}</td><td class="text">{{ a.default }}</td><td class="text">{{ a.who }}</td><td class="text">{{ a.when }}</td><td class="text">{{ a.why }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </details>
</section>

<section id="reproducibility">
  <h2>Reproducibility</h2>
  <p>Run id <code>{{ run_id }}</code>, {{ title }} {{ version }}. The full run manifest, with the fingerprints of every output file, is <code>manifest.json</code> next to this page.</p>
  <div class="scroll"><table>
    <thead><tr><th>Input</th><th>Size (bytes)</th><th>Rows</th><th>SHA-256</th></tr></thead>
    <tbody>{% for i in inputs %}<tr><td>{{ i.name }}</td><td>{{ i.size }}</td><td>{% for s in i.sheets %}{{ s.name }}: {{ s.rows }}{% if not loop.last %}, {% endif %}{% endfor %}</td><td class="text"><code>{{ i.sha256 }}</code></td></tr>{% endfor %}</tbody>
  </table></div>
  <div class="scroll"><table>
    <thead><tr><th>Specification</th><th>Version</th><th>Title</th></tr></thead>
    <tbody>{% for s in specs %}<tr><td>{{ s.id }}</td><td>{{ s.version }}</td><td class="text">{{ s.title }}</td></tr>{% endfor %}</tbody>
  </table></div>
</section>

</main>
<script>{{ plotly_js|safe }}</script>
<script type="application/json" id="figures">{{ figures_json|safe }}</script>
<script>
(function () {
  var figures = JSON.parse(document.getElementById("figures").textContent);
  function token(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function draw() {
    var ramp = token("--seq").replace(/"/g, "").split(",");
    var scale = ramp.map(function (c, k) { return [k / (ramp.length - 1), c]; });
    Object.keys(figures).forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var fig = JSON.parse(JSON.stringify(figures[id]));
      fig.data.forEach(function (trace) { trace.colorscale = scale; });
      var ink = token("--text-secondary");
      fig.layout.paper_bgcolor = token("--surface");
      fig.layout.plot_bgcolor = token("--surface");
      fig.layout.font = { color: ink, family: "system-ui, sans-serif", size: 12 };
      fig.layout.title.font = { color: token("--text-primary"), size: 14 };
      fig.layout.margin = { l: 64, r: 16, t: 40, b: 48 };
      fig.layout.height = 300;
      fig.layout.xaxis.showgrid = false;
      fig.layout.yaxis.showgrid = false;
      fig.layout.xaxis.zeroline = false;
      fig.layout.yaxis.zeroline = false;
      Plotly.react(el, fig.data, fig.layout, { displaylogo: false, responsive: true });
    });
  }
  draw();
  if (window.matchMedia) {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
  }
})();
</script>
</body>
</html>
